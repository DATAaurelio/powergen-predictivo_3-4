    {
      "cell_type": "code",
      "source": [
        "#Creamos un solo df con informacion de los 3, ordenados por ID_Equipo y Fecha\n",
        "def mezclar_datasets(caracteristicas_equipos, historicos_ordenes, registros_condiciones):\n",
        "    merged_data = pd.merge(caracteristicas_equipos, historicos_ordenes, on='ID_Equipo', how='outer')\n",
        "    merged_data = pd.merge(merged_data, registros_condiciones, on=['ID_Equipo', 'Fecha'], how='outer')\n",
        "    merged_data = merged_data.sort_values(by=['ID_Equipo', 'Fecha'])\n",
        "    merged_data = merged_data.fillna(method='ffill')\n",
        "    return merged_data"
      ],
      "outputs": [],
      "execution_count": 21,
      "metadata": {},
      "id": "2de2d52e"
    },
