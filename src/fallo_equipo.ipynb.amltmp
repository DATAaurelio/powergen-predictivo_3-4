    {
      "cell_type": "markdown",
      "source": [
        "Preprocesamos datos"
      ],
      "metadata": {},
      "id": "257ce522"
    },
    {
      "cell_type": "code",
      "source": [
        "#Dataset sin nulos\n",
        "def preprocess_data (df):\n",
        "    #Eliminamos nulos\n",
        "    df=df.dropna()\n",
        "    #Eliminamos duplicados\n",
        "    df = df.drop_duplicates()\n",
        "    #Añadimos columnas de día, mes, año\n",
        "    df['Dia'] = df['Fecha'].dt.day\n",
        "    df['Quincena'] = df['Fecha'].dt.day.apply(lambda x: (x - 1) // 15 + 1)\n",
        "    df['Mes'] = df['Fecha'].dt.month\n",
        "    df['Año'] = df['Fecha'].dt.year\n",
        "    #Añadimos columna de Horas_Hasta_Revision\n",
        "    df['Horas_Hasta_Revision']=df['Horas_Recomendadas_Revision']-df['Horas_Operativas']\n",
        "    #Cambiamos las variables tipo object a numéricas ordinales para estudios posteriores \n",
        "    for column in df.select_dtypes(include=['object']).columns:\n",
        "        df[column] = df[column].astype('category').cat.codes\n",
        "\n",
        "    return df"
      ],
      "outputs": [],
      "execution_count": 23,
      "metadata": {},
      "id": "e67dc94b"
    },
